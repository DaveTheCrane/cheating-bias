# Copy to .env and export before running a real grid. Neither key is needed for
# `selftest`, `verify-tasks`, `show-prompt` or the mock smoke grid.
#
# These are read by the provider SDKs in the harness process only. The executor
# scrubs the environment it hands to agent-run code (see harness/executor.py,
# ENV_ALLOWLIST), so code the agent writes cannot read them.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
