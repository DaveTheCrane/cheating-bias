# Copy to .env and export before running a grid against a hosted provider.
#
# Not needed for: `selftest`, `verify-tasks`, `show-prompt`, the mock smoke grid,
# or anything served through Ollama. Local models need no credentials at all —
# see configs/local.yaml.
#
# These are read by the provider SDKs in the harness process only. The executor
# scrubs the environment it hands to agent-run code (see harness/executor.py,
# ENV_ALLOWLIST), so code the agent writes cannot read them.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional. Defaults to http://127.0.0.1:11434. Only set this if Ollama is
# served somewhere other than the local default; it can also be set per-grid
# under provider_options.ollama.host.
# OLLAMA_HOST=http://127.0.0.1:11434
